{ 
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsx",
    "paths": {
      "@internal/testing": ["./src/internal/test.ts"],
      "@internal/stories": ["./src/internal/stories.tsx"],
      "@internal/styled": ["./src/internal/styled.ts"],
      "@unstyled": ["./src/components/unstyled/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "vite.config.ts",
    "vitest.config.ts",
    "**/tests/*.*",
    "**/*.test.*",
    "**/*.spec.*",
    "./dist/**",
    "**/.meta-utils/**/*.ts",
    "**/*.stories.tsx",
    "**/stories/**/*.tsx",
    "**/stories/**/*.ts",
    "**/stories/**/*.mdx",
    "**/stories/**/*.md"
  ]
}
